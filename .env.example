# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored and must never be committed; this file must contain
# placeholders only — never real credentials.

# Contact form (Nodemailer)
EMAIL=
EMAIL_PASS=

# Google Maps (client-exposed on purpose — NEXT_PUBLIC_ prefix required)
NEXT_PUBLIC_MAPS_API_KEY=

# MongoDB (Phase 3)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority
MONGODB_URI=

# Auth.js / GitHub OAuth (Phase 4)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
ADMIN_GITHUB_ID=

# Cloudinary signed uploads (Phase 4, Checkpoint 4.5) — no unsigned preset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
